# Hoppscotch Community Edition 2026.9.0 on Railway: every variable with its TEMPLATE expression.
# ${{secret(N)}} values are generated per deploy; everything else is a literal or a reference.
# Nothing here needs to be filled in at deploy time.

########## Hoppscotch (public; domain -> port 80; health /ping on PORT 8080) ##########
# Railway Postgres connection (private network)
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Encrypts secrets stored in the infra_config table (OAuth secrets, SMTP password, JWT/session secrets).
# Must be exactly 32 characters. Never change it after the first boot.
DATA_ENCRYPTION_KEY=${{secret(32)}}
# Derives the ed25519 key the webapp-server uses to sign desktop-app bundles (stable across redeploys,
# so no volume is needed for /data/webapp-server).
WEBAPP_SERVER_SIGNING_SECRET=${{secret(48)}}
# One domain for everything: / = app, /admin = admin dashboard, /backend = API, Caddy on :80
ENABLE_SUBPATH_BASED_ACCESS=true
# Backend's internal port (Caddy proxies /backend -> localhost:8080). Do NOT set it to 80.
PORT=8080
# Behind Railway's proxy: take the client IP from X-Forwarded-For (rate limiting, logs)
TRUST_PROXY=true
# CORS / desktop-app origins. For the Hoppscotch Desktop app add app://<your_domain_with_dots_and_dashes_as_underscores>
WHITELISTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}},app://localhost_3200,app://hoppscotch
VITE_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
VITE_SHORTCODE_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
VITE_ADMIN_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/admin
VITE_BACKEND_GQL_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/backend/graphql
VITE_BACKEND_WS_URL=wss://${{RAILWAY_PUBLIC_DOMAIN}}/backend/graphql
VITE_BACKEND_API_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/backend/v1

# --- Optional (not in the template) ---
# PROXY_APP_URL=https://proxy.hoppscotch.io   # default proxy offered to clients; also editable in /admin
# VITE_APP_TOS_LINK=
# VITE_APP_PRIVACY_POLICY_LINK=
# VITE_PROXYSCOTCH_ACCESS_TOKEN=
#
# NOT env vars any more (2026.x): JWT_SECRET, SESSION_SECRET, the auth providers
# (VITE_ALLOWED_AUTH_PROVIDERS, GOOGLE_*/GITHUB_*/MICROSOFT_*) and SMTP (MAILER_*) live in the
# database. The backend generates JWT/session secrets itself on first boot, and you set the auth
# providers and SMTP in the onboarding wizard at /admin (later: /admin -> Settings).
# Setting them as Railway variables has no effect.

########## Postgres (Railway Postgres, ghcr.io/railwayapp-templates/postgres-ssl:18, volume /var/lib/postgresql/data) ##########
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{ secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") }}
POSTGRES_DB=railway
PGDATA=/var/lib/postgresql/data/pgdata
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=${{ POSTGRES_USER }}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
SSL_CERT_DAYS=820
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
